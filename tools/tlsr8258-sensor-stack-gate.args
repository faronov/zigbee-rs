# Static stack gate for the TB-04 default (full-SRAM SUSPEND) sensor image.
# Run by tools/tlsr8258-firmware.sh after the layout check:
#   tools/tlsr8258-stack-report.py ELF --compact --check @tools/tlsr8258-sensor-stack-gate.args
#
# Heuristic direct-call bound, not a whole-program proof: recursion is cut and
# the unresolved indirect edges below are reviewed, not proven bounded. HIL
# stack paint stays the authoritative runtime evidence.
#
# Budget history: the image had a 20 KiB SVC stack. HIL paint measured a
# 15,136 B high-water (fresh join + interview, CCM* decrypt), but this
# analyzer bounded the app-level rejoin-failure fallback, then nested under
# the failing secure rejoin (SensorApp::record_failed_rejoin -> steering ->
# nlme_network_discovery -> radio TX), at ~22.4 KB. The leaf images therefore
# use a 24 KiB SVC stack with a 64 B guard and >= 4 KiB of free RAM between
# the last static byte and the guard.

# The only SVC root: `_rust_entry` -> suspend::run, one executor root.
--svc-root
_rust_entry

--declared-svc
24576
--declared-irq
1024
--min-gap
4096

# Regression budgets: worst SVC path through any matching function, measured
# on the final ELF (22,236 B) and rounded up to the next 256 B boundary. The
# rejoin-failure budget also fails if that path stops being reachable or
# analyzed, so the root worst case can never silently drop it.
# Re-baselined 22272 -> 22528 for the SED recovery change (staged rejoin,
# APS-ack strikes, RecoveryPolicy): the app future grew and secure_rejoin()
# gained a second caller, so it is no longer inlined. Worst path 22,236 ->
# 22,348 B (+112 B), 2,228 B under the declared 24 KiB SVC stack.
# Re-targeted and tightened when the reset-and-fresh-join fallback moved out
# of the failing chain: record_failed_rejoin() now only schedules it, and
# service_fallback_rejoin() runs it from the top of the lifecycle (cold
# start, end of a step). Fallback chain 22,428 -> 19,404 B; worst path and
# steering-rejoin 22,428 -> 20,644 B, 3,932 B under the declared SVC stack.
--chain-budget
rejoin-failure=SensorApp<.*>::(service_fallback_rejoin|rejoin_after_reset)=19456
--chain-budget
steering-rejoin=(start_or_resume_steering|secure_rejoin|rejoin_with|start_fresh_steering|nlme_network_discovery)=20736

# Reviewed functions with unresolved indirect call sites (dyn FnMut /
# cluster vtables / flash guard hooks). Same list as the router gate plus the
# two NWK closures that call the security journal's `replay_commit:
# &mut dyn FnMut(NwkReplayCounter) -> bool` hook (inlined differently in the
# router). Any new one fails the gate.
--allow-unresolved
^<&mut dyn core::ops::function::FnMut<\.\.> as core::ops::function::FnMut<\.\.>>::call_mut$
--allow-unresolved
^<&mut dyn core::ops::function::FnMut<\.\.> as core::ops::function::FnOnce<\.\.>>::call_once::\{shim:vtable#0\}$
--allow-unresolved
^<core::option::Option<\.\.>>::or_else::<<\.\.>::dispatch_inner::\{closure#7\}>$
--allow-unresolved
^<zigbee_aps::ApsLayer<\.\.>>::process_incoming_aps_frame_with_data_persistence$
--allow-unresolved
^<zigbee_bdb::BdbLayer<\.\.>>::finalize_tclk_success::\{closure#0\}$
--allow-unresolved
^<zigbee_bdb::BdbLayer<\.\.>>::reserve_trust_center_link_key$
--allow-unresolved
^<zigbee_nwk::NwkLayer<\.\.>>::join_via_rejoin::\{closure#0\}$
--allow-unresolved
^<zigbee_nwk::NwkLayer<\.\.>>::process_incoming_nwk_frame_from_with_replay_commit::\{closure#0\}$
--allow-unresolved
^<zigbee_runtime::ZigbeeDevice<\.\.>>::send_due_reports::\{closure#0\}$
--allow-unresolved
^<zigbee_runtime::zcl_dispatch::LocalZclCtx<\.\.>>::(apply_configure_reporting|dispatch|reset_zcl_to_factory_defaults)$
--allow-unresolved
^<zigbee_runtime::zcl_dispatch::LocalZclCtx<\.\.>>::with_cluster(_mut|_for_direction)?::<.*<\.\.>::dispatch_inner::\{closure#\d+\}>$
--allow-unresolved
^tlsr8258_hal::flash::ensure_safe_flash$
--allow-unresolved
^zigbee_aps::apsde::aps_decrypt_incoming::<zigbee_mac::soft_mac::SoftMacCore<\.\.>>$
--allow-unresolved
^zigbee_zcl::foundation::(discover::process_discover_extended_dyn|write_attributes::(process_write_dyn|validate_write_undivided_dyn))$
