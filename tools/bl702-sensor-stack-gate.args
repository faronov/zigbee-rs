# Static stack gate for the production BL702 XT-ZB1 sleepy sensor ELF.
# Usage: tools/bl702-stack-gate.py ELF @tools/bl702-sensor-stack-gate.args
#
# Heuristic direct-call bound, not a whole-program proof: indirect calls
# other than the executor poll and the CLIC dispatch pointer are not
# followed. The hardware stack paint stays the authoritative runtime
# evidence.

# products/bl702-xt-zb1/link/memory.x: 24 KiB stack below the reset-time
# memory window, 64-byte guard immediately below it.
--declared
24576
--guard
64
--stack-ceiling
0x4202C000

# Static worst case was SensorApp tick -> failed-rejoin recovery ->
# join_or_resume -> secured receive, 20,096 B task + 80 B entry + 112 B
# interrupt = 20,288 B, a 4,288 B gap (it did not fit the former 15 KiB
# stack). The reset-and-fresh-join fallback now runs from the top of the
# lifecycle (service_fallback_rejoin), not nested under the failing
# secure_rejoin: worst case 15,392 B task, 15,584 B total, 8,992 B gap, and
# the rejoin chain is back to 8,656 B. Not measured on hardware.
--min-gap
4096
--max-frame
4096

# Roots. The executor reaches the task poll through a function pointer and
# the CLIC trap reaches the HAL dispatcher the same way; the gate adds the
# worst of each (entry + task + trap entry + handler). Interrupts do not
# nest (mstatus.MIE stays clear in the handler).
--entry
^main$
--task
^<embassy_executor::raw::TaskStorage<.*>>::poll$
--irq-entry
^_bl702_clic_trap$
--irq-handler
::time_driver::dispatch$

# Reviewed exception (exact symbol). One-shot boot frame: build_profile
# assembles the OTA sensor profile in place (WithOta::init) before the
# SensorApp runs. Measured 3,840 B; cap rounded up to the next 256 B.
--frame-allow
bl702_sensor::build_profile=4096

# Chain budgets: worst depth below (and including) any matching function,
# measured on the 24 KiB fix build, rounded up to the next 256 B boundary
# above the measurement. A regression fails the build.
--chain-budget
boot=^bl702_sensor::build_(mac|profile|device)$=4096
--chain-budget
commissioning=join_or_resume|start_or_resume_steering|start_fresh_steering|nlme_network_discovery=14080
--chain-budget
rejoin=secure_rejoin|rejoin_with|tick_steering_deferred_reset=8704
--chain-budget
secured-receive=process_incoming_aps_frame_with_data_persistence|aps_decrypt_incoming|process_incoming_nwk_frame_from_with_replay_commit|NwkSecurity>::decrypt_with|authenticate_incoming=2048
--chain-budget
security-journal=^<zigbee_runtime::security_journal::SecurityStateJournal<=1792
--chain-budget
reporting=send_due_reports=2048
--chain-budget
factory-reset-leave=factory_reset|nlme_leave|handle_mgmt_leave_req=2560
--chain-budget
ota=^<zigbee_runtime::ota::OtaManager<=3840
