# Home Assistant Connect ZBT-1 (EFR32MG21A020F1024IM32: 1 MiB flash, 8 KiB
# pages, 96 KiB RAM). Chained: the resident Gecko Bootloader 2.4.2
# (0x0..0x4000) is never written and starts whatever is at 0x4000 — here the
# zigbee-rs loader. The GP Proxy Table journal, the router tables and the
# security journal keep the addresses of link/memory.x; the slots end below
# the GP window (0xF0000), so a loader-linked router carries Green Power.
# Loader-version 1 had 0x76000-byte slots ending at 0xF4000; version 2 shrank
# each by 8 KiB. Recovery without SWD: the Gecko UART bootloader (see the
# loader's `gecko-recovery` feature), which rewrites 0x4000+.
# Watchdog: WDOG0 (ULFRCO) for the boot decision only, stopped before the
# hand-over; 8 s requested -> PERSEL 11 (>= 14.9 s, nominally 16.4 s).
name           = ha-connect-zbt1
flash          = 0x0..0x100000
sector         = 0x2000
reserved       = 0x0..0x4000 gecko-bootloader
loader         = 0x4000..0x8000
primary        = 0x8000..0x7C000
secondary      = 0x7C000..0xF0000
reserved       = 0xF0000..0xF4000 gp-proxy-table
reserved       = 0xF4000..0xFC000 router-tables
journal        = 0xFC000..0x100000
ram            = 0x20000000..0x20018000
header         = 0x200
vector-align   = 0x200
loader-version = 2
trial-boots    = 3
watchdog-ms    = 8000
mode           = overwrite
env-prefix     = ZBT1
key-file       = ../../../bootloaders/keys/own-ec-p256.xy.hex
